    "/api/v1/me/mfa": {
      "get": {
        "operationId": "get_api_mfa_status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "API MFA enrollment, enforcement, and authorization state for a user.",
                  "properties": {
                    "credentials": {
                      "description": "Registered passkeys.",
                      "items": {
                        "description": "A registered passkey exposed through the API MFA settings endpoints.",
                        "properties": {
                          "created_at": {
                            "format": "date-time",
                            "type": "string"
                          },
                          "id": {
                            "format": "int64",
                            "type": "integer"
                          },
                          "last_used_at": {
                            "format": "date-time",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "created_at"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "enabled": {
                      "description": "Whether the user has opted into API MFA.",
                      "type": "boolean"
                    },
                    "enforcement_active": {
                      "description": "Whether the server is currently applying MFA on dangerous mutates\n(`API_MFA_ENFORCEMENT_ENABLED`). Bootstrap / plant-prevention gates stay on\neven when this is false.",
                      "type": "boolean"
                    },
                    "grant_expires_at": {
                      "description": "Active grant expiry, if any.",
                      "format": "date-time",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "has_verified_email": {
                      "description": "Whether the user has a verified email (required to send email OTPs).",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "enabled",
                    "enforcement_active",
                    "credentials",
                    "has_verified_email"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Get API MFA status for the authenticated user.",
        "tags": [
          "users"
        ]
      },
      "put": {
        "description": "Enabling requires at least one registered passkey and a fresh email OTP so a\nstolen session cookie alone cannot turn on enforcement after planting a passkey.\n\nDisabling requires a fresh passkey assertion **or** email OTP. Enforcement may\nremain enabled with zero passkeys (dangerous actions stay blocked until a\npasskey is registered via email OTP recovery).",
        "operationId": "update_api_mfa_status",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request to enable or disable API MFA for the authenticated user.",
                "properties": {
                  "credential": {
                    "description": "Passkey assertion: required when disabling if no `email_code` is provided.\n\nObtain options from `POST /api/v1/me/mfa/authorize/start` first.",
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "email_code": {
                    "description": "Email OTP from `POST /api/v1/me/mfa/email_codes`.\n\nRequired when enabling. When disabling, accepted as an alternative to `credential`\n(e.g. recovery when all passkeys were removed).",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "enabled": {
                    "description": "Whether to enable API MFA enforcement.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "enabled"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "API MFA state returned after an update.",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "enabled"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Enable or disable API MFA for the authenticated user.",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/me/mfa/authorize/finish": {
      "post": {
        "operationId": "finish_api_mfa_authorize",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Browser assertion submitted to finish passkey authorization.",
                "properties": {
                  "credential": {
                    "description": "Credential assertion response from the browser."
                  }
                },
                "required": [
                  "credential"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Details of the short-lived grant issued after passkey authorization.",
                  "properties": {
                    "grant_expires_at": {
                      "description": "When the newly issued grant expires.",
                      "format": "date-time",
                      "type": "string"
                    }
                  },
                  "required": [
                    "grant_expires_at"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Finish passkey authentication and issue a 15-minute wildcard API MFA grant.",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/me/mfa/authorize/start": {
      "post": {
        "description": "Also used as the passkey step-up ceremony before disabling API MFA or registering\nan additional passkey while MFA is enabled (see `PUT /api/v1/me/mfa` and\n`POST /api/v1/me/mfa/passkeys/start`). Disabling may use email OTP instead.",
        "operationId": "start_api_mfa_authorize",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Browser options returned when starting passkey authorization.",
                  "properties": {
                    "public_key": {
                      "description": "`PublicKeyCredentialRequestOptions` for `navigator.credentials.get()`."
                    }
                  },
                  "required": [
                    "public_key"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Start passkey authentication to create a short-lived API MFA grant.",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/me/mfa/email_codes": {
      "post": {
        "description": "Requires a verified email address. The code is never returned in the response.",
        "operationId": "send_api_mfa_email_code",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Delivery details for a newly issued email OTP.",
                  "properties": {
                    "expires_at": {
                      "description": "When the emailed code expires.",
                      "format": "date-time",
                      "type": "string"
                    },
                    "sent_to_hint": {
                      "description": "Masked destination address (e.g. `a***@example.com`).",
                      "type": "string"
                    }
                  },
                  "required": [
                    "expires_at",
                    "sent_to_hint"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Email a one-time code for API MFA enable/disable, passkey enrollment, or\nchanging away from a verified email address.",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/me/mfa/passkeys/finish": {
      "post": {
        "operationId": "finish_webauthn_registration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Browser credential and label submitted to finish passkey registration.",
                "properties": {
                  "credential": {
                    "description": "Credential creation response from the browser."
                  },
                  "name": {
                    "description": "Label for the new passkey.",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "credential"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Registered passkey returned after successful enrollment.",
                  "properties": {
                    "credential": {
                      "description": "A registered passkey exposed through the API MFA settings endpoints.",
                      "properties": {
                        "created_at": {
                          "format": "date-time",
                          "type": "string"
                        },
                        "id": {
                          "format": "int64",
                          "type": "integer"
                        },
                        "last_used_at": {
                          "format": "date-time",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "created_at"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "credential"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Finish passkey registration and store the credential.",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/me/mfa/passkeys/start": {
      "post": {
        "description": "Step-up:\n- API MFA on with existing passkeys: fresh passkey assertion (`credential`)\n- otherwise (first enroll, recovery with zero passkeys, or MFA off): email OTP",
        "operationId": "start_webauthn_registration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Step-up credentials used to begin passkey registration.",
                "properties": {
                  "credential": {
                    "description": "Required when API MFA is enabled and at least one passkey exists: assertion from\n`authorize/start` so a stolen session cookie alone cannot register another passkey."
                  },
                  "email_code": {
                    "description": "Email OTP from `POST /api/v1/me/mfa/email_codes`.\n\nRequired when the user has no passkeys (first enroll or recovery) or when API MFA\nis off (prevents a hijacked session from planting a passkey before enable).",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Browser options returned when starting passkey registration.",
                  "properties": {
                    "public_key": {
                      "description": "`PublicKeyCredentialCreationOptions` for `navigator.credentials.create()`."
                    }
                  },
                  "required": [
                    "public_key"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Start passkey registration for the authenticated user.",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/me/mfa/passkeys/{id}": {
      "delete": {
        "description": "When API MFA is enabled, requires a passkey assertion or email OTP so a stolen\nsession cookie alone cannot strip backup keys. The last passkey may be deleted\nwhile enforcement stays on; dangerous actions remain blocked until a passkey is\nregistered again (email OTP recovery) or MFA is disabled.",
        "operationId": "delete_webauthn_credential",
        "parameters": [
          {
            "description": "Credential ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Step-up credentials used to authorize passkey deletion.",
                "properties": {
                  "credential": {
                    "description": "Passkey assertion from `authorize/start` (preferred when a passkey remains)."
                  },
                  "email_code": {
                    "description": "Email OTP alternative when API MFA is enabled (e.g. deleting the last passkey).",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "example": true,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Delete a registered passkey.",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/me/security_events": {
      "get": {
        "description": "Events are retained for 90 days. Cookie authentication only.",
        "operationId": "list_security_events",
        "parameters": [
          {
            "description": "The page number to request.\n\nThis parameter is mutually exclusive with `seek` and not supported for\nall requests.",
            "in": "query",
