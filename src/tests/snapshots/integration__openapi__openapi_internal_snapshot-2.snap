                        "$ref": "#/components/schemas/Category"
                      },
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "crate": {
                      "$ref": "#/components/schemas/Crate",
                      "description": "The crate metadata."
                    },
                    "keywords": {
                      "description": "The keywords of the crate.",
                      "example": null,
                      "items": {
