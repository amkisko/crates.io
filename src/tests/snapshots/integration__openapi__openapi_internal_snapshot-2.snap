      "put": {
        "description": "Requires a cookie session for the invited user. The path token selects the\ninvitation; it is not a standalone bearer capability.",
        "operationId": "accept_crate_owner_invitation_with_token",
        "parameters": [
          {
            "description": "Secret token sent to the user's email address",
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "crate_owner_invitation": {
                      "properties": {
                        "accepted": {
                          "description": "Whether the invitation was accepted.",
                          "example": true,
                          "type": "boolean"
                        },
                        "crate_id": {
                          "description": "The opaque identifier for the crate this invitation is for.",
                          "example": 42,
                          "format": "int32",
                          "type": "integer"
                        }
                      },
                      "required": [
                        "crate_id",
                        "accepted"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "crate_owner_invitation"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Accept a crate owner invitation with a token.",
        "tags": [
          "owners"
        ]
      }
    },
