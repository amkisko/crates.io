                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "List recent security activity for the authenticated user.",
        "tags": [
          "users"
        ]
      }
    },
