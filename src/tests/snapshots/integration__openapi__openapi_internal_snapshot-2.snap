          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "example": true,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "api_token": []
          },
          {
            "cookie": []
          }
        ],
        "summary": "Yank a crate version.",
        "tags": [
          "versions"
        ]
      }
    },
