{% extends "base.html.j2" %}

{% block content %}
<p>Hello {{ user_name }}!</p>

<p>Your API MFA verification code is:</p>

<p style="font-size: 1.5rem; font-family: monospace; letter-spacing: 0.1em;"><strong>{{ otp }}</strong></p>

<p>Enter this code on the crates.io Settings → API MFA page. It expires in {{ expires_minutes }} minutes.</p>

<p>If you did not request this code, you can ignore this email. Someone with access to your crates.io session may be trying to change API MFA settings.</p>
{% endblock %}
